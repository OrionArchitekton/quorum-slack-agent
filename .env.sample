# Slack sandbox
SLACK_BOT_TOKEN=xoxb-...
SLACK_USER_TOKEN=xoxp-...          # RTS private-channel scopes
SLACK_SIGNING_SECRET=...
SLACK_TEAM_ID=T...
DECISION_LOG_CHANNEL_ID=C...        # #decision-log
DECISION_LOG_CANVAS_ID=F...         # canonical Decision Log canvas (created once)
# Model (Vercel AI Gateway)
AI_GATEWAY_API_KEY=...
QUORUM_MODEL=anthropic/claude-sonnet-4.5
QUORUM_CLASSIFIER_MODEL=anthropic/claude-haiku-4.5
# Proactive nudge: comma-separated channel IDs to watch. EMPTY = nudge disabled (default, no spam).
QUORUM_NUDGE_CHANNELS=
# Dev
QUORUM_FAKE_LLM=0
