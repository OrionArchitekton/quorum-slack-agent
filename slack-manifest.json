{
  "display_information": {
    "name": "Quorum",
    "description": "Decision memory for your workspace — captures, files, and recalls team decisions.",
    "background_color": "#2b2d42"
  },
  "features": {
    "bot_user": { "display_name": "Quorum", "always_online": true },
    "shortcuts": [
      {
        "name": "📌 Capture decision",
        "type": "message",
        "callback_id": "quorum_capture",
        "description": "Capture this thread as a Decision Record"
      }
    ],
    "slash_commands": [
      {
        "command": "/decisions",
        "description": "Ask what we decided about X",
        "usage_hint": "what did we decide about auth?",
        "url": "https://REPLACE_WITH_DEPLOY_URL/api/slack/events",
        "should_escape": false
      }
    ],
    "assistant_view": {
      "assistant_description": "Captures and recalls team decisions with sourced citations."
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "assistant:write",
        "chat:write",
        "commands",
        "canvases:write",
        "canvases:read",
        "channels:history",
        "groups:history",
        "im:history",
        "search:read.public",
        "search:read.files",
        "search:read.users"
      ],
      "user": [
        "search:read.private",
        "search:read.im",
        "search:read.mpim",
        "search:read.public"
      ]
    }
  },
  "settings": {
    "is_mcp_enabled": true,
    "event_subscriptions": {
      "request_url": "https://REPLACE_WITH_DEPLOY_URL/api/slack/events",
      "bot_events": [
        "assistant_thread_started",
        "assistant_thread_context_changed",
        "message.im",
        "message.channels",
        "app_mention"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://REPLACE_WITH_DEPLOY_URL/api/slack/interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
